# PostgreSQL connection used by the API and import script.
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/talking_rabbit

# Optional: use a dedicated read-only database account for AI-generated queries.
# READONLY_DATABASE_URL=postgresql+psycopg2://readonly_user:password@localhost:5432/talking_rabbit

# Gemini API key used by the AI endpoints.
GEMINI_API_KEY=your_gemini_api_key
